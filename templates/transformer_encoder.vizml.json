  "edges": [
    {
      "id": "sequence-positions",
      "source": "sequence",
      "target": "positions"
    },
    {
      "id": "positions-encoder",
      "source": "positions",
      "target": "encoder"
    },
    {
      "id": "encoder-norm",
      "source": "encoder",
      "target": "norm"
    },
    {
      "id": "norm-pool",
      "source": "norm",
      "target": "pool"
    },
    {
      "id": "pool-classes",
      "source": "pool",
      "target": "classes"
    }
