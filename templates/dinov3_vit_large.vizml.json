{
  "version": 1,
  "name": "DINOv3 · ViT-L/16",
  "template": "dinov3_vit_large",
  "nodes": [
    {
      "id": "image",
      "type": "layer",
      "position": {
        "x": 0,
        "y": 80
      },
      "data": {
        "kind": "grid_input",
        "label": "Image · RGB",
        "params": {
          "width": 224,
          "height": 224,
          "channels": 3
        }
      }
    },
    {
      "id": "patches",
      "type": "layer",
      "position": {
        "x": 250,
        "y": 80
      },
      "data": {
        "kind": "patch_embed",
        "label": "Patch / CLS / storage tokens",
        "params": {
          "patch": 16,
          "features": 1024,
          "cls_token": 1,
          "registers": 4,
          "mask_token": 1
        }
      }
    },
    {
      "id": "encoder",
      "type": "layer",
      "position": {
        "x": 500,
        "y": 80
      },
      "data": {
        "kind": "transformer_block",
        "label": "RoPE encoder · 24 blocks",
        "params": {
          "blocks": 24,
          "heads": 16,
          "mode": "encoder",
          "expansion": 4,
          "activation": "gelu",
          "norm_style": "pre",
          "eps": 0.00001,
          "layer_scale": 0.00001,
          "qkv_bias": 1,
          "proj_bias": 1,
          "ffn_bias": 1,
          "mask_k_bias": 1,
          "dropout": 0,
          "position": "rope2d",
          "rope_base": 100
        }
      }
    },
    {
      "id": "norm",
      "type": "layer",
      "position": {
        "x": 750,
        "y": 80
      },
      "data": {
        "kind": "layernorm",
        "label": "Shared final normalization",
        "params": {
          "eps": 0.00001
        }
      }
    },
    {
      "id": "cls",
      "type": "layer",
      "position": {
        "x": 1000,
        "y": 80
      },
      "data": {
        "kind": "token_pool",
        "label": "Select CLS token",
        "params": {
          "method": "cls",
          "prefix": 1
        }
      }
    },
    {
      "id": "embedding",
      "type": "layer",
      "position": {
        "x": 1250,
        "y": 80
      },
      "data": {
        "kind": "embedding",
        "label": "1024-D image embedding",
        "params": {}
      }
    },
    {
      "id": "patch_tokens",
      "type": "layer",
      "position": {
        "x": 1000,
        "y": 310
      },
      "data": {
        "kind": "token_pool",
        "label": "Select normalized patch tokens",
        "params": {
          "method": "patches",
          "prefix": 5
        }
      }
    },
    {
      "id": "patch_output",
      "type": "layer",
      "position": {
        "x": 1250,
        "y": 310
      },
      "data": {
        "kind": "embedding",
        "label": "Dense visual features",
        "params": {}
      }
    }
  ],
  "edges": [
    {
      "id": "image-patches",
      "source": "image",
      "target": "patches"
    },
    {
      "id": "patches-encoder",
      "source": "patches",
      "target": "encoder"
    },
    {
      "id": "encoder-norm",
      "source": "encoder",
      "target": "norm"
    },
    {
      "id": "norm-cls",
      "source": "norm",
      "target": "cls"
    },
    {
      "id": "cls-embedding",
      "source": "cls",
      "target": "embedding"
    },
    {
      "id": "norm-patch_tokens",
      "source": "norm",
      "target": "patch_tokens"
    },
    {
      "id": "patch_tokens-patch_output",
      "source": "patch_tokens",
      "target": "patch_output"
    }
  ]
}
