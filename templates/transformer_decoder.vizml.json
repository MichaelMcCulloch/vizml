{
  "version": 1,
  "name": "Transformer · causal language model",
  "template": "transformer_decoder",
  "nodes": [
    {
      "id": "tokens",
      "type": "layer",
      "position": {
        "x": 0,
        "y": 80
      },
      "data": {
        "kind": "token_input",
        "label": "Prompt tokens",
        "params": {
          "tokens": 128
        }
      }
    },
    {
      "id": "embed",
      "type": "layer",
      "position": {
        "x": 250,
        "y": 80
      },
      "data": {
        "kind": "token_embedding",
        "label": "Token embedding",
        "params": {
          "vocab": 32000,
          "features": 256
        }
      }
    },
    {
      "id": "positions",
      "type": "layer",
      "position": {
        "x": 500,
        "y": 80
      },
      "data": {
        "kind": "position_encoding",
        "label": "Learned positions",
        "params": {
          "method": "learned"
        }
      }
    },
    {
      "id": "decoder",
      "type": "layer",
      "position": {
        "x": 750,
        "y": 80
      },
      "data": {
        "kind": "transformer_block",
        "label": "Causal decoder · 6 blocks",
        "params": {
          "blocks": 6,
          "heads": 8,
          "mode": "decoder",
          "expansion": 4,
          "activation": "gelu",
          "norm_style": "pre",
          "eps": 0.00001,
          "layer_scale": 0,
          "qkv_bias": 1,
          "proj_bias": 1,
          "ffn_bias": 1,
          "mask_k_bias": 0,
          "dropout": 0,
          "position": "none",
          "rope_base": 10000
        }
      }
    },
    {
      "id": "norm",
      "type": "layer",
      "position": {
        "x": 1000,
        "y": 80
      },
      "data": {
        "kind": "layernorm",
        "label": "Final normalization",
        "params": {
          "eps": 0.00001
        }
      }
    },
    {
      "id": "logits",
      "type": "layer",
      "position": {
        "x": 1250,
        "y": 80
      },
      "data": {
        "kind": "token_head",
        "label": "Next-token logits",
        "params": {
          "vocab": 32000
        }
      }
    }
  ],
  "edges": [
    {
      "id": "tokens-embed",
      "source": "tokens",
      "target": "embed"
    },
    {
      "id": "embed-positions",
      "source": "embed",
      "target": "positions"
    },
    {
      "id": "positions-decoder",
      "source": "positions",
      "target": "decoder"
    },
    {
      "id": "decoder-norm",
      "source": "decoder",
      "target": "norm"
    },
    {
      "id": "norm-logits",
      "source": "norm",
      "target": "logits"
    }
  ]
}
